:: Ustawienia {"position":"150,150","size":"100,100"}
{
  <!-- You don't need a table, but I just wanted to build one.-->
  <table id="settings">
    <tr>
      <th>Motyw:</th>
      <td>
        (dropdown: 2bind $chosenTheme, "jasny", "ciemny")
        <span class="mini-buttons">
          (link-repeat: "✔")[
            (if: $chosenTheme is "ciemny")[
              <script>settingThemeChange(1)</script>
            ](else:)[
              <script>settingThemeChange(0)</script>
            ]
          ]
        </span>
      </td>
    </tr>
    <tr>
      <th>Rozmiar tekstu:</th>
      <td><span class="mini-buttons">
        (link-repeat: "−")[(set: $fontSize to it - 0.1)<script>settingFontSize($fontSize);</script>] / 
        (link-repeat: "+")[(set: $fontSize to it + 0.1)<script>settingFontSize($fontSize);</script>]
      </span></td>
    </tr>
  </table>
  <!--Essentially, if you want to add more, just add a row and fill it up.-->
}


:: Zmienne [startup] {"position":"25,25","size":"100,100"}
{
    (set: const-type $wersjaGry to "0.8.24+2013")

  <!-- Dane nagłówka -->
    (set: const-type $numerDniaStart to 1)
    (set: const-type $poraDniaStart to "noc")
    (set: num-type $numerDnia to $numerDniaStart)
    (set: (p-either: "rano", "wieczór", "noc")-type $poraDnia to $poraDniaStart)

  <!-- Wizyty -->
    (set: _nazwyStron to (altered: via its name, ...(passages:)))
    (set: $liczbaOdwiedzin to (dm: ...(interlaced: _nazwyStron, (repeated: _nazwyStron's length, 0))))
    (set: $zwrocOdwiedzone to (macro: [(out-data: (altered: _entry via _entry's name, ...(find: _entry where _entry's value > 0, ...(dm-entries: $liczbaOdwiedzin))))]))
    (set: $odwiedzoneDzis to (a: ))
    
  <!-- Inkrementacja czasu -->
    (set: $zmienDzien to (macro: [
        (set: $numerDnia to it + 1)
        (set: $poraDnia to "rano")
        (set: $odwiedzoneDzis to (a: ))
        (out: )[]
    ]))

  <!-- Dane słownika -->
    (set: const-type $slowa to (a:
        (a: "spanie", "fujfuj1"),
        (a: "jedzenie", "fujfuj2"),
        (a: "niedobre", "fujfuj3"),
        (a: "pies", "fujfuj4"),
        (a: "być", "fujfuj5"),
        (a: "bogini", "fujfuj6"),
        (a: "zostać", "fujfuj7"),
        (a: "cela", "fujfuj8"),
        (a: "ty", "fujfuj9"),
        (a: "ja", "fujfuj10"),
        (a: "nowy", "fujfuj11"),
        (a: "iść", "fujfuj12"),
        (a: "praca", "fujfuj13"),
        (a: "rzeka", "fujfuj14"),
        (a: "ryba", "fujfuj15"),
        (a: "metal", "fujfuj16"),
        (a: "wioska", "fujfuj17"),
        (a: "brać", "fujfuj18"),
        (a: "jutro", "fujfuj19"),
        (a: "dobre", "fujfuj20"),
    ))
    (set: const-type $slowaSzambolanskie to (altered: _slowo via _slowo's 2nd, ...$slowa))
    (set: $tlumaczeniaGracza to (altered: _entry via "", ...$slowa))
    (set: const-type $slownik to (dm: ...(interlaced: (altered: _slowo via _slowo's 1st, ...$slowa), (range: 1, $slowa's length))))

  <!-- Makra pomocnicze do wypisywania i modyfikacji słów. -->
    (set: $wypiszSzambolanskiNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $slowaSzambolanskie's _nrSlowa)
        (out: )[_doWypisania]
    ]))
    (set: $wypiszTlumaczenieNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $tlumaczeniaGracza's _nrSlowa)
        (out: )[_doWypisania]
    ]))
    (set: $zaktualizujTlumaczenieNr to (macro: num-type _nrSlowa, str-type _znaczenie, [
        (set: $tlumaczeniaGracza's _nrSlowa to _znaczenie)
        (store-data: "tlumaczenieGracza", $tlumaczeniaGracza)
        (out: )[]
    ]))
    (set: $edytujTlumaczenieNr to (macro: num-type _nrSlowa, [
        (out: )[{=
          <div class="translation-editor">
            (input: 2bind _doWypisania, "X", $tlumaczeniaGracza's _nrSlowa)
            (link-repeat: "💾")[{=
                (set: $tlumaczeniaGracza's _nrSlowa to _doWypisania)
                (store-data: "tlumaczenieGracza", $tlumaczeniaGracza)
            ]
            (link-repeat: "🔄")[(set: _doWypisania to $tlumaczeniaGracza's _nrSlowa)]
            (link-repeat: "🚫")[{=
                (set: $tlumaczeniaGracza's _nrSlowa to "")
                (set: _doWypisania to "")
                (store-data: "tlumaczenieGracza", $tlumaczeniaGracza)
            ]
          </div>
        ]
    ]))
    (set: $wypiszPrzelaczaneNr to (macro: num-type _nrSlowa, [
        (set: bool-type _czyTlumaczyc to false)
        (set: _doWypisaniaSzambolanskie to $slowaSzambolanskie's _nrSlowa)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's _nrSlowa)
        (if: _doWypisaniaTlumaczenie is an empty)[
            (out: )[_doWypisaniaSzambolanskie]
        ]
        (else: )[
            (out: )[{=
                |slowo>[(cond: _czyTlumaczyc, _doWypisaniaTlumaczenie, _doWypisaniaSzambolanskie)]
                (click-rerun:?slowo)[(set: _czyTlumaczyc to not it)(rerun:?slowo)]
            ]
        ]
    ]))
    (set: $wypiszRubyNr to (macro: num-type _nrSlowa, [
        (set: _doWypisaniaSzambolanskie to $slowaSzambolanskie's _nrSlowa)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's _nrSlowa)
        (out: )[<ruby>
            _doWypisaniaSzambolanskie
            <rp>(</rp><rt>_doWypisaniaTlumaczenie</rt><rp>)</rp>
        </ruby>]
    ]))

    (set: $wypiszSzambolanski to (macro: str-type _slowo, [
        (out: )[($wypiszSzambolanskiNr: $slownik's _slowo)]
    ]))
    (set: $wypiszTlumaczenie to (macro: str-type _slowo, [
        (out: )[($wypiszTlumaczenieNr: $slownik's _slowo)]
    ]))
    (set: $zaktualizujTlumaczenie to (macro: str-type _slowo, str-type _znaczenie, [
        ($zaktualizujTlumaczenieNr: $slownik's _slowo, _znaczenie)
        (out: )[]
    ]))
    (set: $wypiszRuby to (macro: str-type _slowo, [
        (out: )[($wypiszRubyNr: $slownik's _slowo)]
    ]))

  <!-- Zapisywanie/wczytywanie tłumaczeń -->
    (set: $wyczyscTlumaczenia to (macro: [
        (set: $tlumaczeniaGracza to (altered: _entry via "", ...$slowa))
        (clear-data: "tlumaczenieGracza", $tlumaczeniaGracza)
        (out: )[]
    ]))
    (set: $czyZapisanoTlumaczenia to (macro: [
        (out-data: (has-data: "tlumaczenieGracza"))
    ]))
    (set: $wczytajTlumaczenia to (macro: [
        (set: $tlumaczeniaGracza to (load-data: "tlumaczenieGracza"))
        (out: )[]
    ]))
 
  <!-- Sprawdzenie, czy nie ma powtórzeń w słowach po szambolańsku. -->
    (set: _slownikSprawdzenie to (macro: [
        (set: _ileJestRoznychSzambolanskich to (unique: ...$slowaSzambolanskie)'s length)
        (set: _ileJestRoznychSlow to $slowa's length)
        (if: _ileJestRoznychSzambolanskich < _ileJestRoznychSlow)[(error: "Więcej niż jedno słowo tłumaczy się na to samo po szambolańsku!")]
        (out: )[]
    ]))
    (_slownikSprawdzenie: )

  <!-- For Settings Autoload -->
    (set: $lastpassage to "Start")
    (set: $chosenTheme to "Bright Theme")
    (set: $chosenFront to "Sans-Serif")
    (set: $fontSize to 1.5)
    (set: $setNamingSaves to "Autoname")

  <!-- Rzeczy zależne od motywu -->
    (set: $jesliCiemnyMotyw to (macro: any-type _jesliCiemny, any-type _jesliJasny, [(out: )[{=
      <div class="theme-limited" data-theme="dark">
        _jesliCiemny
      </div>
      <div class="theme-limited" data-theme="light sepia">
        _jesliJasny
      </div>
    ]]))
    
    (set: $obrazekOkladkaDark to [{=
      <img width="100%" src="https://i.imgur.com/8wlDaQT.png" />
    ])
    (set: $obrazekOkladkaLight to [{=
      <img width="100%" src="https://i.imgur.com/0cwGc2h.png" />
    ])
    
  <!-- Koniec gry i zapis -->
    (set: $rozpocznijNowaGre to (macro: str-type _tekstPrzycisku, [
        (out: )[(link: _tekstPrzycisku)[
            (store-data: "wyczyscZapis", true)
            (restart: )
        ]]
    ]))
    (set: $nazwaZapisu to "Autosave")
    (set: $wczytajAutozapis to (macro: [
        (if: (has-data: "wyczyscZapis"))[]
        (else-if: not (has-data: "wersjaGry"))[]
        (else: )[(if: (load-data: "wersjaGry") is $wersjaGry and (saved-games: ) contains $nazwaZapisu)[(load-game: $nazwaZapisu)]]
        (out: )[]
    ]))
    (set: $zapiszAutozapis to (macro: [
        (clear-data: "wyczyscZapis")
        (store-data: "wersjaGry", $wersjaGry)
        (save-game: $nazwaZapisu)
        (out: )[]
    ]))













}


:: dead2 [dead-end 2-run] {"position":"1000,2300","size":"100,100"}
Niestety, szybkie przemknięcie się koło szambolan nie było dobrym pomysłem. Istoty te cechowały sie nadzwyczajnie dobrym słuchem. Gdy tylko Kari Mata Hari próbowała się przekraść wokół nich, natychmiast zdali sobie sprawę z jej obecności.

Suczka z łatwością została obezwładniona, Nie miała szans w starciu z czwórką dorosłych szambolan.  Znalazła się z powrotem w ohydnej, obleśnej celi. 

Kari Mata Hari aż do końca swoich dni nie miała więcej szans na ucieczkę. Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

KONIEC

($rozpocznijNowaGre: "Kliknij tutaj, by zacząć przygodę od nowa")


:: dead3 [dead-end 2-run] {"position":"1700,2300","size":"100,100"}
Kari Mata po wejściu do kosza nagle poczuła, że ktoś ją podnosi. Po dłuższej chwili, została gwałtownie wyrzucona z kosza. Spełniła się jej największa obawa. Dwójka szambolan patrzyła na nia z góry swoimi małymi, czarnymi oczami.

Suczka z łatwością została obezwładniona, Nie miała szans w starciu z dwójką dorosłych szambolan.  Znalazła się z powrotem w ohydnej, obleśnej celi. 

Kari Mata Hari aż do końca swoich dni nie miała więcej szans na ucieczkę. Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

