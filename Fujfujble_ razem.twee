    <td></td>
</tr>
<tr>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
    <td></td>
</tr>
</table>

<script>
(function() {
const backButton = Array.from(document.querySelectorAll("tw-link")).filter(e => e.innerText === "Powrót")[0];
const result = { won: false, lost: false };
backButton.addEventListener("click", () => lost = false);
const password = Array.from("BAGNO");
const guess = [];
const rows = Array.from(document.querySelectorAll("#wordle-container tr"));
let currentRow = 0;
let currentColumn = 0;
const removeLetter = () => {
    if (currentColumn === 0) {
        return;
    }
    currentColumn--;
    rows[currentRow].querySelectorAll("td")[currentColumn].innerText = "";
    guess.pop();
};
const putLetter = (letter) => {
    if (currentColumn >= 5) {
        return;
    }
    rows[currentRow].querySelectorAll("td")[currentColumn].innerText = letter;
    guess.push(letter);
    currentColumn++;
};
const submitRow = () => {
    if (currentColumn < 5) {
        return;
    }
    const greenMatches = guess.map((e, i) => e === password[i]);
    const leftoverLetters = password.filter((e, i) => !greenMatches[i]);
    Array.from(rows[currentRow].querySelectorAll("td")).forEach((e, i) => {
        if (greenMatches[i]) {
            e.classList.add("correct");
        } else if (leftoverLetters.indexOf(guess[i]) >= 0) {
            e.classList.add("wrong-position");
            leftoverLetters.splice(leftoverLetters.indexOf(guess[i]), 1);
            console.log(leftoverLetters);
        } else {
            e.classList.add("wrong");
        }
    });
    if (guess.join("") === password.join("")) {
        result.won = true;
        console.log(result);
        window.open("https://milka82.itch.io/superheros-i-dating-simulator", "_blank");
    }
    currentRow++;
    currentColumn = 0;
    guess.splice(0);
    if (currentRow >= 6) {
        result.lost = true;
        console.log(result);
        backButton.click();
    }
};
document.addEventListener("keyup", evt => {
    console.log(result);
    if (result.won || result.lost) {
        return;
    }
    if (evt.key.match(/^[a-z]$/)) {
        putLetter(evt.key.match(/^([a-z])$/)[1].toUpperCase());
    } else if (evt.key === 'Backspace') {
        removeLetter();
    } else if (evt.key === 'Enter') {
        submitRow();
    }
});
})();
</script>


:: Intro {"position":"800,300","size":"100,100"}
(if: ($czyZapisanoTlumaczenia: ))[($wczytajTlumaczenia: )]\
(if: $liczbaOdwiedzin's ((passage: )'s name) is 0)[\
"Oślepłam."
To pierwsze słowo, które pojawiło się w myślach Kari Maty Hari, gdy się ocknęła.
Nic dziwnego. Otaczał ją całkowity mrok. Jej zmysł węchu działał za to znakomicie. Na nieszczęście, bo do jej nosa dochodził jedynie obrzydliwy smród. Nieznośny zapach przyprawiał ją o mdłości.

Kari Mata spróbowała na chwilę zapomnieć, że w ogóle posiada nos i wytężyła swój słuch. 
Przestrzeń, w której się znajdowała, wypełniały dziwne szepty i odgłosy.
Docierające do jej uszu bulgoty, gulgoty i dziwne akcentowania nie przywodziły jej na myśl żadnego narzecza, które znała. Nie dziwiło jej to. W końcu tam, skąd pochodzi, jest wiele grup etnicznych posługujących się własnymi odmianami językowymi. Miała zresztą dużo poważniejsze zmartwienia na głowie. Jej myśli zaprzątały kolejne pytania. Co tu robi? Jak się tu znalazła? I jak może się stąd wydostać?

Gdy tak rozmyślała, jej wzrok powoli przyzwyczajał się do panujących wokół egipskich ciemności. Zaczęła dostrzegać zarysy rzeczy, które ją otaczały. Ściany małego pomieszczenia, w którym się znajdowała. Coś na kształt posłania po swojej lewej. Przed sobą miskę. A nieco dalej kraty.

]\
Suczka zdała sobie sprawę, że znajduje się w celi. Prawdopodobnie została uprowadzona. Postanowiła nie czekać na ratunek i wziąć sprawy w swoje łapy. W tym celu bohaterka...

[[...najpierw rozejrzała się po celi, by rozeznać się dokładniej w swoim położeniu.->look]]
[[...spróbowała zwrócić na siebie uwagę dziwnych głosów.->talk]]


:: Nagłówek [header] {"position":"25,150","size":"100,100"}
{
  <!-- Autozapis -->
  (if: (passage:)'s name is "Start")[($wczytajAutozapis: )]
  (else: )[($zapiszAutozapis: )]
  <!-- Liczba odwiedzin -->
    (if: (passage:)'s name is not in (a: "Start", "Słownik") and (history: )'s length > 0)[(set: $liczbaOdwiedzin's (history: )'s last to it + 1)]<!-- [[Start]] [[Słownik]] -->
    (if: "lokacja" is in (passage: )'s tags)[(set: $odwiedzoneDzis to it + (a: (passage: )'s name))]
    (if: (passage: )'s name is "wioskamapa")[(set: $poraDnia to "rano")]<!-- [[wioskamapa]] -->
    (else-if: (passage: )'s name is "mapanoc")[(set: $poraDnia to "wieczór")]<!-- [[mapanoc]] -->
    (else-if: (passage: )'s name is "sen")[(set: $poraDnia to "noc")]<!-- [[sen]] -->
  <!--The title Header-->
  (prepend:?SideBar)[{=
      <tw-header>
          (if: (passage:)'s name is "Start")[FUJFUJBLE!]<!-- [[Start]] -->
          (else-if: (passage:)'s name is "Słownik")[SŁOWNIK]<!-- [[Słownik]] -->
          (else: )[DZIEŃ $numerDnia ($poraDnia)]
      </tw-header>
  ]
  <!--Ustawienia wyglądu-->
  (if: $chosenTheme is "ciemny")[
    <script>settingThemeChange(1)</script>
  ](else:)[
    <script>settingThemeChange(0)</script>
  ]
  (if: $chosenFront is "Serif")[
    <script>settingFontFamily(2)</script>
  ](elseif: $chosenFront is "Sans-Serif")[
    <script>settingFontFamily(1)</script>
  ](else:)[
    <script>settingFontFamily(0)</script>
  ]
  <script>settingFontSize($fontSize);</script>
}


