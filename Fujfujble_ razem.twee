:: Ustawienia {"position":"150,150","size":"100,100"}
{
  <!-- You don't need a table, but I just wanted to build one.-->
  <table id="settings">
    <tr>
      <th>Motyw:</th>
      <td>
        (dropdown: 2bind $chosenTheme, "jasny", "ciemny")
        <span class="mini-buttons">
          (link-repeat: "✔")[{=
            ($zapiszMotyw: $chosenTheme)
            (if: $chosenTheme is "ciemny")[{=
              <script>settingThemeChange(1)</script>
            ](else:)[{=
              <script>settingThemeChange(0)</script>
            ]
          ]
        </span>
      </td>
    </tr>
    <tr>
      <th>Rozmiar tekstu:</th>
      <td><span class="mini-buttons">
        (link-repeat: "−")[{=
            (set: $fontSize to it - 0.1)
            ($zapiszRozmiarTekstu: $fontSize)
            <script>settingFontSize($fontSize);</script>
        ] / 
        (link-repeat: "+")[{=
            (set: $fontSize to it + 0.1)
            ($zapiszRozmiarTekstu: $fontSize)
            <script>settingFontSize($fontSize);</script>
        ]
      </span></td>
    </tr>
  </table>
  <!--Essentially, if you want to add more, just add a row and fill it up.-->
}


:: Zmienne [startup] {"position":"25,25","size":"100,100"}
{
    (set: const-type $wersjaGry to "1.1.0+2609162031")

  <!-- Dane nagłówka -->
    (set: const-type $domyslnyMotyw to "jasny")
    (set: const-type $domyslnyRozmiarTekstu to 1.5)

    (set: const-type $numerDniaStart to 1)
    (set: const-type $poraDniaStart to "wieczór")
    (set: num-type $numerDnia to $numerDniaStart)
    (set: (p-either: "rano", "wieczór", "noc")-type $poraDnia to $poraDniaStart)
    (set: num-type $limitDni to 4)

  <!-- Wizyty -->
    (set: _nazwyStron to (altered: via its name, ...(passages:)))
    (set: $liczbaOdwiedzin to (dm: ...(interlaced: _nazwyStron, (repeated: _nazwyStron's length, 0))))
    (set: $zwrocOdwiedzone to (macro: [(out-data: (altered: _entry via _entry's name, ...(find: _entry where _entry's value > 0, ...(dm-entries: $liczbaOdwiedzin))))]))
    (set: $odwiedzoneDzis to (a: ))
    (set: $ekwipunek to (a: ))
    (set: bool-type $rzekaCzekanie to false)

  <!-- Inkrementacja czasu -->
    (set: $zmienDzien to (macro: [
        (set: $numerDnia to it + 1)
        (set: $poraDnia to "rano")
        (set: $odwiedzoneDzis to (a: ))
        (set: $rzekaCzekanie to false)
        (out: )[]
    ]))

  <!-- Dane słownika -->
    (set: const-type $slowa to (a:
        (a: "jedzenie", "bleblefuj"),
        (a: "niedobre", "fuj"),
        (a: "pies", "gulbula"),
        (a: "być", "tfu"),
        (a: "bogini", "bulabula"),
        (a: "zostać", "łełełe"),
        (a: "więzienie", "fujfujble"),
        (a: "ty", "fefe"),
        (a: "ja", "fe"),
        (a: "iść", "łe"),
        (a: "praca", "fujfujgul"),
        (a: "rzeka", "blegul"),
        (a: "ryba", "gulgulgul"),
        (a: "metal", "bulfujfe"),
        (a: "wioska", "fujble"),
        (a: "jutro", "fu-tfu"),
        (a: "dobre", "blefuj"),
        (a: "kretyn", "fu-fuj"),
        (a: "haha", "haha"),
    ))
    (set: const-type $slowaSzambolanskie to (altered: _slowo via _slowo's 2nd, ...$slowa))
    (set: $tlumaczeniaGracza to (altered: _entry via "", ...$slowa))
    (set: const-type $slownik to (dm: ...(interlaced: (altered: _slowo via _slowo's 1st, ...$slowa), (range: 1, $slowa's length))))

  <!-- Makra pomocnicze do wypisywania i modyfikacji słów. -->
    (set: $wypiszSzambolanskiNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $slowaSzambolanskie's _nrSlowa)
        (out: )[_doWypisania]
    ]))
    (set: $zwrocSzambolanskiNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $slowaSzambolanskie's _nrSlowa)
        (out-data: _doWypisania)
    ]))
    (set: $wypiszTlumaczenieNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $tlumaczeniaGracza's _nrSlowa)
        (out: )[_doWypisania]
    ]))
    (set: $zaktualizujTlumaczenieNr to (macro: num-type _nrSlowa, str-type _znaczenie, [
        (set: $tlumaczeniaGracza's _nrSlowa to _znaczenie)
        (store-data: "tlumaczenieGracza", $tlumaczeniaGracza)
        (out: )[]
    ]))
    (set: $ikonaZapisu to "💾")
    (set: $ikonaPrzywrocenia to "🔄")
    (set: $ikonaUsuniecia to "🗑️")
    (set: $edytujTlumaczenieNr to (macro: num-type _nrSlowa, [
        (out: )[{=
          <div class="translation-editor">
            (input: 2bind _doWypisania, "X", $tlumaczeniaGracza's _nrSlowa)
            (link-repeat: $ikonaZapisu)[{=
                (set: $tlumaczeniaGracza's _nrSlowa to _doWypisania)
                (store-data: "tlumaczenieGracza", $tlumaczeniaGracza)
            ]
            (link-repeat: $ikonaPrzywrocenia)[(set: _doWypisania to $tlumaczeniaGracza's _nrSlowa)]
            (link-repeat: $ikonaUsuniecia)[{=
                (set: $tlumaczeniaGracza's _nrSlowa to "")
                (set: _doWypisania to "")
                (store-data: "tlumaczenieGracza", $tlumaczeniaGracza)
            ]
          </div>
        ]
    ]))
    (set: $wypiszPrzelaczaneNr to (macro: num-type _nrSlowa, [
        (set: bool-type _czyTlumaczyc to false)
        (set: _doWypisaniaSzambolanskie to $slowaSzambolanskie's _nrSlowa)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's _nrSlowa)
        (if: _doWypisaniaTlumaczenie is an empty)[
            (out: )[_doWypisaniaSzambolanskie]
        ]
        (else: )[
            (out: )[{=
                |slowo>[(cond: _czyTlumaczyc, _doWypisaniaTlumaczenie, _doWypisaniaSzambolanskie)]
                (click-rerun:?slowo)[(set: _czyTlumaczyc to not it)(rerun:?slowo)]
            ]
        ]
    ]))
    (set: $wypiszRubyNr to (macro: num-type _nrSlowa, [
        (set: _doWypisaniaSzambolanskie to $slowaSzambolanskie's _nrSlowa)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's _nrSlowa)
        (out: )[<ruby>
            _doWypisaniaSzambolanskie
            <rp>(</rp><rt>_doWypisaniaTlumaczenie</rt><rp>)</rp>
        </ruby>]
    ]))

    (set: $wypiszSzambolanski to (macro: str-type _slowo, [
        (out: )[($wypiszSzambolanskiNr: $slownik's _slowo)]
    ]))
    (set: $zwrocSzambolanski to (macro: str-type _slowo, [
        (out-data: ($zwrocSzambolanskiNr: $slownik's _slowo))
    ]))
    (set: $wypiszTlumaczenie to (macro: str-type _slowo, [
        (out: )[($wypiszTlumaczenieNr: $slownik's _slowo)]
    ]))
    (set: $zaktualizujTlumaczenie to (macro: str-type _slowo, str-type _znaczenie, [
        ($zaktualizujTlumaczenieNr: $slownik's _slowo, _znaczenie)
        (out: )[]
    ]))
    (set: $wypiszRuby to (macro: str-type _slowo, [
        (out: )[($wypiszRubyNr: $slownik's _slowo)]
    ]))
    (set: $pustyWybor to "(puste)")
    (set: $wybierzRuby to (macro: any-type _partialDropdown, any-type _szambolanskie, [
        (set: _dropdown to (_partialDropdown: $pustyWybor, ...$slowaSzambolanskie))
        (out: )[_dropdown <rp>(</rp><rt>(live: 0.5s)[_szambo]</rt><rp>)</rp>]
    ]))
    (set: $zwrocSlownikGracza to (macro: [
        (out-data: (dm: ...(interlaced: (altered: _slowo via _slowo's 2nd, ...$slowa), (altered: _nr via _nr of $tlumaczeniaGracza, ...(range: 1, $slowa's length)))))
    ]))
    (set: $wypiszUkrytySlownikGracza to (macro: [
        (out: )[<section class="user-dictionary-lookup">
            (for: each _item, ...(dm-entries: ($zwrocSlownikGracza: )))[<p class="dictionary-entry"><span class="name">(print: _item's name)</span><span class="value">(print: _item's value)</span></p>]
  </section>]
    ]))
    (set: $sprawdzZdanie to (macro: (a: ...str)-type _wymagane, (a: ...str)-type _niedozwolone, ...str-type _zdanie, [
        (set: _zdanieBezPustych to (find: _wyraz where _wyraz is not $pustyWybor, ..._zdanie))
        (replace: ?text)[_zdanieBezPustych]
        (out-data: _zdanieBezPustych contains all of (altered: via ($zwrocSzambolanski: it), ..._wymagane) and all of (altered: via ($zwrocSzambolanski: it), ..._niedozwolone) is not in _zdanie)
    ]))
    (set: $wypiszSkryptPodgladuZdania to (macro: [
    	(out: )[{=
<script>
(() => {
    const userDictionary = Object.fromEntries(Array.from(document.querySelectorAll("section.user-dictionary-lookup p.dictionary-entry")).map(e => [e.querySelector('span.name').innerText, e.querySelector('span.value').innerText]));
    const rubyChildrenWithSelect = Array.from(document.querySelector("ruby.dropdown-ruby").children).filter(e => e.querySelector('select'));
    rubyChildrenWithSelect.forEach(e => {
        const translationBegin = document.createElement('rp');
        translationBegin.innerText = "(";
        const translation = document.createElement('rt');
        const translationEnd = document.createElement('rp');
        translationEnd.innerText = ")";
        const select = e.querySelector('select');
        e.insertAdjacentElement("afterend", translationBegin);
        e.insertAdjacentElement("afterend", translation);
        e.insertAdjacentElement("afterend", translationEnd);
        select.addEventListener("change", evt => translation.innerText = userDictionary[evt.target.value] ?? "");
    });
})();
</script>
        ]
    ]))

  <!-- Zapisywanie/wczytywanie tłumaczeń -->
    (set: $wyczyscTlumaczenia to (macro: [
        (set: $tlumaczeniaGracza to (altered: _entry via "", ...$slowa))
        (clear-data: "tlumaczenieGracza")
        (out: )[]
    ]))
    (set: $czyZapisanoTlumaczenia to (macro: [
        (out-data: (has-data: "tlumaczenieGracza"))
    ]))
    (set: $wczytajTlumaczenia to (macro: [
        (set: _tymczasoweTlumaczenia to (load-data: "tlumaczenieGracza"))
        (for: each _nr, ...(range: 1, _tymczasoweTlumaczenia's length))[
            (if: $tlumaczeniaGracza's _nr's length is 0)[
                (set: $tlumaczeniaGracza's _nr to _tymczasoweTlumaczenia's _nr)
            ]
        ]
        (out: )[]
    ]))
 
  <!-- Sprawdzenie, czy nie ma powtórzeń w słowach po szambolańsku. -->
    (set: _slownikSprawdzenie to (macro: [
        (set: _ileJestRoznychSzambolanskich to (unique: ...$slowaSzambolanskie)'s length)
        (set: _ileJestRoznychSlow to $slowa's length)
        (if: _ileJestRoznychSzambolanskich < _ileJestRoznychSlow)[(error: "Więcej niż jedno słowo tłumaczy się na to samo po szambolańsku!")]
        (if: _ileJestRoznychSlow is not 19)[(error: "Liczba słów uległa zmianie i nie wynosi już 19!")]
        (out: )[]
    ]))
    (_slownikSprawdzenie: )

  <!-- For Settings Autoload -->
    (set: $lastpassage to "Start")
    (set: $chosenFront to "Sans-Serif")
    (set: $setNamingSaves to "Autoname")

    (set: $zapiszMotyw to (macro: str-type _motyw, [
        (store-data: "chosenTheme", _motyw)
        (out: )[]
    ]))
    (set: $zapiszRozmiarTekstu to (macro: num-type _rozmiarTekstu, [
        (store-data: "fontSize", _rozmiarTekstu)
        (out: )[]
    ]))

    (if: not (has-data: "chosenTheme"))[
        ($zapiszMotyw: $domyslnyMotyw)
    ]
    (if: not (has-data: "fontSize"))[
        ($zapiszRozmiarTekstu: $domyslnyRozmiarTekstu)
    ]
    (set: $chosenTheme to (load-data: "chosenTheme"))
    (set: $fontSize to (load-data: "fontSize"))

  <!-- Rzeczy zależne od motywu -->
    (set: $jesliCiemnyMotyw to (macro: any-type _jesliCiemny, any-type _jesliJasny, [(out: )[{=
      <div class="theme-limited" data-theme="dark">
        _jesliCiemny
      </div>
      <div class="theme-limited" data-theme="light sepia">
        _jesliJasny
      </div>
    ]]))
    
    (set: $obrazekOkladkaDark to [{=
      <img width="100%" src="./intro_dark.png" />
    ])
    (set: $obrazekOkladkaLight to [{=
      <img width="100%" src="./intro_light.png" />
    ])
    
  <!-- Koniec gry i zapis -->
    (set: $stylZakonczenia to (text-style: "bold")+(text-size: 1.5)+(align: "=><="))
    (set: $dobreZakonczenie to (macro: [
        (out: )+$stylZakonczenia+(text-color: green)[DOBRE ZAKOŃCZENIE]
    ]))
    (set: $zleZakonczenie to (macro: [
        (out: )+$stylZakonczenia+(text-color: red)[ZŁE ZAKOŃCZENIE]
    ]))
    (set: $rozpocznijNowaGre to (macro: str-type _tekstPrzycisku, [
        (out: )[(link-repeat: _tekstPrzycisku)[{=
            (store-data: "wyczyscZapis", true)
            (restart: )
        ]]
    ]))
    (set: $nazwaZapisu to "Autosave")
    (set: $wczytajAutozapis to (macro: [
        (if: (has-data: "wyczyscZapis"))[]
        (else-if: not (has-data: "wersjaGry"))[]
        (else: )[(if: (load-data: "wersjaGry") is $wersjaGry and (saved-games: ) contains $nazwaZapisu)[(load-game: $nazwaZapisu)]]
        (out: )[]
    ]))
    (set: $zapiszAutozapis to (macro: [
        (clear-data: "wyczyscZapis")
        (store-data: "wersjaGry", $wersjaGry)
        (save-game: $nazwaZapisu)
        (out: )[]
    ]))
    (set: $opuszczonoCele to false)
    (set: $zapiszOpuszczonoCele to (macro: bool-type _wartosc, [
        (set: $opuszczonoCele to _wartosc)
        (store-data: "opuszczonoCele", $opuszczonoCele)
        (out: )[]
    ]))
    (if: not (has-data: "opuszczonoCele"))[
        ($zapiszOpuszczonoCele: $opuszczonoCele)
    ]
    (set: $opuszczonoCele to (load-data: "opuszczonoCele"))












}


:: badtime [dead-end] {"position":"950,3250","size":"100,100"}
Resztkami sił Kari Mata wypadła na pokryty piaskiem brzeg. W oślepiających promieniach południowego słońca nie widziała, dokąd biegnie. Kierowała się jedynie odgłosami rzeki. Miała nadzieję, że jej cuchnący oprawcy nie wskoczą za nią do wody. I nie wskoczyli, ale nie względu na nienawiść do czystości, a przez to, że uciekająca suczka potknęła się o jeden z kamieni wystających z piaszczystego brzegu. Runęła jak długa na ziemię.

Zdezorientowana, z obolałą głową próbowała się jeszcze podnieść, a potem chociaż czołgać w kierunku wody, ale nie miała już na to sił. Zrezygnowana czekała na najgorsze.

Szambolanie wypadli na plażę za nią i zaraz ją dogonili. Suczka nie miała szans w starciu z nimi.

Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

($zleZakonczenie: )


:: dead2 [dead-end 2-run] {"position":"900,2300","size":"100,100"}
Niestety, przemknięcie obok Szambolan nie było dobrym pomysłem. Istoty te cechowały się nadzwyczajnie dobrym słuchem. Gdy tylko Kari Mata Hari spróbowała wcielić swój plan w życie, natychmiast zdały sobie sprawę z jej obecności.

Suczka z łatwością została obezwładniona. Nie miała szans w starciu z czwórką dorosłych Szambolan. Znalazła się z powrotem w ohydnej, obleśnej celi. 

Kari Mata Hari aż do końca swoich dni nie miała więcej szans na ucieczkę. Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

($zleZakonczenie: )


:: dead3 [dead-end 2-run] {"position":"2200,2300","size":"100,100"}
Kari Mata po wejściu do kosza nagle poczuła, że ktoś ją podnosi. Po dłuższej chwili została gwałtownie wyrzucona z kosza. Spełniła się jej największa obawa. Zobaczyła nad sobą dwójkę Szambolan. Z ich ryjków dobiegało złowrogie warczenie.

Suczka z łatwością została obezwładniona. Nie miała szans w starciu z dwójką dorosłych Szambolan. Znalazła się z powrotem w ohydnej, obleśnej celi.

Kari Mata Hari aż do końca swoich dni nie miała więcej szans na ucieczkę. Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

($zleZakonczenie: )


:: deadend1 [dead-end] {"position":"1350,900","size":"100,100"}
- ($wypiszRuby: "ty") ($wypiszRuby: "być") ($wypiszRuby: "kretyn") - zająknęła się przy mówieniu Kari Mata.
- ($wypiszRuby: "ja") ($wypiszRuby: "być") ($wypiszRuby: "kretyn")?! ($wypiszRuby: "ja")?! - tajemniczy rozmówca naszej bohaterki zaczął się irytować. Bardzo mocno irytować. Cokolwiek nieopatrznie powiedziała Kari Mata, musiało nie być to zbyt uprzejme. 

Istota następnie otworzyła celę suczki i zamachnęła się, by wymierzyć cios. Mata Hari nie zdążyła niestety zrobić uniku. Gwałtowne uderzenie sprawiło, że Kari osunęła się na ziemię i straciła przytomność. Niestety, miała jej już nigdy nie odzyskać.

($zleZakonczenie: )


:: end1 [dead-end] {"position":"2400,2300","size":"100,100"}
Kari Mata szła w wyznaczonym kierunku. Z minuty na minutę jej chód stawał się coraz wolniejszy. Oddech robił się coraz cięższy, a ciało odmawiało posłuszeństwa. 
W końcu dało za wygraną i upadło bezwiednie na ziemię. Kilka dni funkcjonowania w ciągłym stresie przed wykryciem, bez regularnego dostępu do pożywienia, znacząco osłabiło organizm suczki. 

Mata Hari nie wiedziała, ile czasu leżała tak bezsilnie na ziemi. Każda chwila spędzona na mokrym, brudnym bajorze wydawała jej się wiecznością. 

Naraz poczuła, że ktoś ją podnosi. Usłyszała ostatkiem sił znajomy obcy język z wieloma bulgoczącymi dźwiękami, po czym straciła przytomność. 

Gdy się ocknęła, stała twarzą w twarz z liczną gromadą Szambolan wpatrujących się w nią jak w obrazek. Próbowała się ruszyć. Nie mogła. Jej ręce i nogi były przywiązane do pala wbitego w ziemię. 

Naraz zobaczyła blask. Ktoś rozpalił pochodnię. Jednocześnie tłum Szambolan zaczął recytować:

"($wypiszRuby: "bogini") ($wypiszRuby: "być") ($wypiszRuby: "dobre"). ($wypiszRuby: "bogini") ($wypiszRuby: "zostać") ($wypiszRuby: "wioska"). ($wypiszRuby: "bogini") ($wypiszRuby: "być") ($wypiszRuby: "dobre"). ($wypiszRuby: "bogini") ($wypiszRuby: "zostać") ($wypiszRuby: "wioska")"

Przerażona Kari Mata zamknęła oczy, przygotowując się na najgorsze. 

Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

($zleZakonczenie: )


:: escapemap {"position":"1100,700","size":"100,100"}
Podobno mowa jest srebrem, a milczenie złotem, lecz w tym wypadku bohaterka stwierdziła, że srebro jest cenniejsze od złota. Rozważając wszystko, co wydarzyło się w czasie tego krótkiego pobytu w celi, postanowiła...

[[...wskazać na siebie i powiedzieć: ($wypiszRuby: "pies") ($wypiszRuby: "być") ($wypiszRuby: "niedobre")->map0]]
[[...wskazać na istotę i powiedzieć: ($wypiszRuby: "ty") ($wypiszRuby: "być") ($wypiszRuby: "niedobre")->deadend1]]
[[...wskazać na istotę i powiedzieć: ($wypiszRuby: "ty") ($wypiszRuby: "być") ($wypiszRuby: "więzienie")->hahaneutral]]
[[...wskazać na siebie i powiedzieć: ($wypiszRuby: "pies") ($wypiszRuby: "być") ($wypiszRuby: "jedzenie")->hahabeka]]
[[...zrezygnować z pomysłu i zrobić coś innego.->Intro]]


:: firstszambo {"position":"975,1250","size":"100,100"}
($zapiszOpuszczonoCele: true)\
(if: ($czyZapisanoTlumaczenia: ))[($wczytajTlumaczenia: )]\
Kari Mata wyjrzała na zewnątrz. Wokół panował półmrok, w którym dziewczynie było nieco łatwiej rozeznać się niż w ciemnej celi. Ze wstępnych obserwacji wynikało, że znajdowała się w pewnego rodzaju wiosce ukrytej w liściach gęstej dżungli. Z żalem stwierdziła, że wszędobylski smród nadal się utrzymywał i był jeszcze gorszy niż w więzieniu, z którego się wydostała. 

Nim zdążyła obmyślić swój kolejny ruch, naraz usłyszała znajomy obcy język. W przypływie adrenaliny suczka postanowiła...

[[....rozejrzeć się za kryjówką i poczekać, aż ją miną.->szambopass]]
[[...szybko pobiec w kierunku przeciwnym od tego, z którego dobiegają głosy.->firstszambodeath]]


:: firstszambodeath [dead-end] {"position":"1200,1350","size":"100,100"}
Nie było czasu do stracenia. Ktoś się zbliżał i na pewno nie miał wobec bohaterki dobrych zamiarów. Trzeba było szybko uciekać.

W panicznym biegu Kari Mata nastąpiła na coś, co wydało dość głośny dźwięk. Przystanęła na chwilę zaalarmowana nagłym hałasem, po czym wznowiła ucieczkę.
Niestety, tym niefortunnym momentem zwróciła na siebie uwagę istot, od których uciekała. Z łatwością ją dogoniły, po czym zabrały z powrotem do ohydnej, obleśnej celi. Kari Mata Hari aż do końca swoich dni nie znalazła kolejnej szansy na ucieczkę z więzienia.

($zleZakonczenie: )


:: goodend1 {"position":"1100,2900","size":"100,100"}
Gdy tylko pierwsze drzewa przysłoniły bramę wioski, Kari Mata oparła się plecami o jeden z pni i odetchnęła z ulgą. Była już poza wzrokiem strażników, a więc bezpieczna. Czując przypływ zmęczenia, osunęła się w kucki. Skryła twarz w dłoniach, bo przedzierające się przez liście drzew poranne słońce, wreszcie bezpośrednio widoczne po tylu dniach w ciemności, irytowało jej gałki oczne tak, że zaczęły łzawić.

Przetarła twarz, by pozbyć się z niej szlamu, ale jej policzki zaraz znowu zrobiły się wilgotne. Uświadomiła sobie, że płacze. Tymczasową ulgę po ucieczce z cuchnącej wioski zastąpiła bezsilność i niepewność, co robić dalej. Bohaterka mimowolnie dopuściła do siebie to, co tak usilnie ignorowała przez ostatnie dni: nawarstwiające się poczucie wycieńczenia, głodu, ból z otarć i siniaków, otępiałość narządów węchu i wzroku.

Suczka postanowiła...

[[...posiedzieć jeszcze chwilę, by dać ciału odpocząć, zanim zacznie działać dalej.->goodfail]]
[[...spróbować wstać i ruszyć dalej pomimo zmęczenia.->goodend2]]


:: goodend2 {"position":"1100,3050","size":"100,100"}
Kari Mata przetarła oczy jeszcze raz i, wsparłszy się znowu o pień, powoli wstała. Wiedziała, że tak blisko wioski nie jest jeszcze bezpieczna. Przypomniała sobie, że lada moment w ślad za nią wyruszą prawdziwi rybacy. Dalsze czekanie tutaj sprawiłoby, że cały jej dotychczasowy plan poszedłby na marne.

Bohaterka wyjrzała zza drzewa w stronę bramy, skąd przyszła. Na szczęście w ślad za nią nikt jeszcze nie wyruszył. Dostrzegła jednak błotną ścieżkę powstałą z ociekającego z niej szlamu. Postanowiła, że szukanie drogi ucieczki nie ma sensu bez obmycia się wpierw w czystej wodzie. [[Ruszyła więc dalej w kierunku rzeki.->goodend3]]


:: goodend3 {"position":"1100,3200","size":"100,100"}
Słońce stało już wysoko. Do uszu bohaterki docierał wyraźnie szum wody wolno płynącej w rzece. (cond: $numerDnia is 4, "Był nadzwyczaj głośny. Bohaterka założyła po prostu, że stanowiący jedno ze źródeł pożywienia Szambolan zbiornik jest po prostu duży i wartki. ", "")Z nadzieją poruszała się w stronę rozmytego w jej łzawiących oczach prześwitu w gąszczu drzew. Jej myśli zalewała euforia spowodowana bliskością pośredniego celu i jednocześnie dalszym brakiem wysłanników z Szambo-La.

Rzeczywiście dzień ucieczki był dla Kari Maty wyjątkowo szczęśliwy. Nie dość, że rybacy wstali później niż zwykle, to jeszcze stracili czas na udowadnianiu swojej tożsamości przed strażnikami, którzy długo nie dawali się przekonać, że doszło do oszustwa. Prymitywność języka nie pomagała w rozmowach.

Mimo całego tego szczęścia plan suczki był od początku skazany na niepowodzenie, o czym jeszcze nie wiedziała, ale zaraz miała się przekonać. Przez coraz donośniejszy szum rzeki przebiły się do jej uszu okrzyki w języku, którego już nigdy miała nadzieję nie usłyszeć.

- ($wypiszRuby: "niedobre") ($wypiszRuby: "niedobre") ($wypiszRuby: "niedobre") ($wypiszRuby: "pies")! ($wypiszRuby: "zostać")! - przekrzykiwały się dwa głosy.

Czując uderzenie adrenaliny, Kari Mata zaczęła (link-goto: "biec na oślep", (cond: $numerDnia is 4, "goodendkoniec", "badtime")).<!-- [[goodendkoniec]] [[badtime]] -->


:: goodendkoniec [true-end] {"position":"1100,3350","size":"100,100"}
Resztkami sił Kari Mata wypadła na pokryty piaskiem brzeg. W oślepiających promieniach południowego słońca nie widziała, dokąd biegnie. Kierowała się jedynie odgłosami rzeki. Miała nadzieję, że jej cuchnący oprawcy nie wskoczą za nią do wody. I nie wskoczyli, ale nie względu na nienawiść do czystości, a przez to, że uciekająca suczka potknęła się o jeden z kamieni wystających z piaszczystego brzegu. Runęła jak długa na ziemię.

Zdezorientowana, z obolałą głową próbowała się jeszcze podnieść, a potem chociaż czołgać w kierunku wody, ale nie miała już na to sił. Zrezygnowana czekała na najgorsze.

Szambolanie nie dopadli jej jednak. Nie wbiegli nawet za nią na plażę. Zatrzymali się u wyjścia lasu tropikalnego na widok sunącej rzeką wielkiej łodzi o niestandardowym kształcie. Naraz powietrze rozdarł dźwięk syreny okrętowej. Szambolanie w popłochu rzucili się do ucieczki.

- ($wypiszRuby: "ryba")! ($wypiszRuby: "metal")! ($wypiszRuby: "metal")! ($wypiszRuby: "ryba")! - wrzeszczeli, biorąc nogi za pas.

Tymczasem łódź przypominająca wielką blaszaną rybę zatrzymała się w pewnej odległości od brzegu - tak, żeby nie osiąść na piasku. Po chwili dało się słyszeć dźwięk otwieranego włazu. Ktoś zeskoczył z łodzi do wody i zaczął biec w kierunku suczki.

Tym kimś był postawny kogut ubrany w niebieski marynarski mundur. Na głowie miał kapitańską czapkę z wygrawerowaną na broszce literką "N". Jego spojrzenie, początkowo ostre, złagodniało, gdy dobiegł do brzegu i rozpoznał pod warstwą błota psią sylwetkę.

- <ruby>jednak nie wyrzutek</ruby>, <ruby>a ucieki-kinier</ruby>... - rzekł do siebie - <ruby>nigdy bym nie przypuszczał</ruby>...

Kari Mata nie była już jednak w stanie usłyszeć, czego nie przypuszczał tajemniczy nieznajomy. Straciła przytomność.

($dobreZakonczenie: )
(text-size: 0.75)+(align: "=><=")[Dziękujemy za grę! Koniecznie podziel się z nami zawartością swojego słownika ;DD]


:: goodfail [dead-end] {"position":"2400,2500","size":"100,100"}
Bohaterka postanowiła jeszcze chwilę pozostać skulona na ziemi. Czuła, jak powoli doskwierające jej bodźce tracą na sile. Nawet nie spostrzegła, kiedy zasnęła. Podobnie jak nie zwróciła uwagi, że jej drogę od bram wioski nieprzerwanie znaczyły błotne ślady.

Gdy się ocknęła, stała twarzą w twarz z liczną gromadą Szambolan wpatrujących się w nią jak w obrazek. Próbowała się ruszyć. Nie mogła. Jej ręce i nogi były przywiązane do pala wbitego w ziemię. 

Naraz zobaczyła blask. Ktoś rozpalił pochodnię. Jednocześnie tłum Szambolan zaczął recytować:

"($wypiszRuby: "bogini") ($wypiszRuby: "być") ($wypiszRuby: "dobre"). ($wypiszRuby: "bogini") ($wypiszRuby: "zostać") ($wypiszRuby: "wioska"). ($wypiszRuby: "bogini") ($wypiszRuby: "być") ($wypiszRuby: "dobre"). ($wypiszRuby: "bogini") ($wypiszRuby: "zostać") ($wypiszRuby: "wioska")"

Przerażona Kari Mata zamknęła oczy, przygotowując się na najgorsze. 

Co mogła zrobić lepiej? Czy z tego przeklętego jądra ciemności nie było ucieczki? A może po prostu los nie był jej przychylny? Tego na pewno nie dowie się już w tym wcieleniu.

($zleZakonczenie: )


