:: Variable startup [startup] {"position":"25,25","size":"100,100"}
{ <!--This is limited to what the template needs.-->
    (set: $namePC to "Jane Doe")
    (set: $lastpassage to "Start")

  <!-- Dane nagłówka -->
    (set: const-type $numerDniaStart to 1)
    (set: const-type $poraDniaStart to "wieczór")
    (set: num-type $numerDnia to $numerDniaStart)
    (set: (p-either: "rano", "południe", "wieczór", "noc")-type $poraDnia to $poraDniaStart)
    
  <!-- Inkrementacja czasu -->
    (set: $zmienDzien to (macro: [
        (set: $numerDnia to it + 1)
        (set: $poraDnia to "rano")
        (out: )[]
    ]))

  <!-- Dane słownika -->
    (set: const-type $slowa to (a:
        (a: "spanie", "fujfuj1"),
        (a: "jedzenie", "fujfuj2"),
        (a: "niedobre", "fujfuj3"),
        (a: "pies", "fujfuj4"),
        (a: "być", "fujfuj5"),
        (a: "bogini", "fujfuj6"),
        (a: "slowo7", "fujfuj7"),
        (a: "slowo8", "fujfuj8"),
        (a: "slowo9", "fujfuj9"),
        (a: "slowo10", "fujfuj10"),
        (a: "slowo11", "fujfuj11"),
        (a: "slowo12", "fujfuj12"),
        (a: "slowo13", "fujfuj13"),
        (a: "slowo14", "fujfuj14"),
        (a: "slowo15", "fujfuj15"),
        (a: "slowo16", "fujfuj16"),
    ))
    (set: $tlumaczeniaGracza to (altered: _entry via "", ...$slowa))
    (set: const-type $slownik to (dm:
        $slowa's 1st's 1st, 1,
        $slowa's 2nd's 1st, 2,
        $slowa's 3rd's 1st, 3,
        $slowa's 4th's 1st, 4,
        $slowa's 5th's 1st, 5,
        $slowa's 6th's 1st, 6,
        $slowa's 7th's 1st, 7,
        $slowa's 8th's 1st, 8,
        $slowa's 9th's 1st, 9,
        $slowa's 10th's 1st, 10,
        $slowa's 11th's 1st, 11,
        $slowa's 12th's 1st, 12,
        $slowa's 13th's 1st, 13,
        $slowa's 14th's 1st, 14,
        $slowa's 15th's 1st, 15,
        $slowa's 16th's 1st, 16,
    ))

  <!-- Makra pomocnicze do wypisywania i modyfikacji słów. -->
    (set: $wypiszSzambolanski to (macro: str-type _slowo, [
        (set: _doWypisania to $slowa's (_slowo of $slownik)'s 2nd)
        (out: )[_doWypisania]
    ]))
    (set: $wypiszTlumaczenie to (macro: str-type _slowo, [
        (set: _doWypisania to $tlumaczeniaGracza's (_slowo of $slownik))
        (out: )[_doWypisania]
    ]))
    (set: $zaktualizujTlumaczenie to (macro: str-type _slowo, str-type _znaczenie, [
        (set: $tlumaczeniaGracza's (_slowo of $slownik) to _znaczenie)
        (out: )[]
    ]))
    (set: $wypiszSzambolanskiNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $slowa's _nrSlowa's 2nd)
        (out: )[_doWypisania]
    ]))
    (set: $wypiszTlumaczenieNr to (macro: num-type _nrSlowa, [
        (set: _doWypisania to $tlumaczeniaGracza's _nrSlowa)
        (out: )[_doWypisania]
    ]))
    (set: $zaktualizujTlumaczenieNr to (macro: num-type _nrSlowa, str-type _znaczenie, [
        (set: $tlumaczeniaGracza's _nrSlowa to _znaczenie)
        (out: )[]
    ]))
    (set: $edytujTlumaczenieNr to (macro: num-type _nrSlowa, [
        (out: )[{=
          <div class="translation-editor">
            (input: 2bind _doWypisania, "X", $tlumaczeniaGracza's _nrSlowa)
            (link-repeat: "✓")[(set: $tlumaczeniaGracza's _nrSlowa to _doWypisania)]
            (link-repeat: "✗")[(set: _doWypisania to $tlumaczeniaGracza's _nrSlowa)]
          </div>
        ]
    ]))
    (set: $wypiszPrzelaczaneNr to (macro: num-type _nrSlowa, [
        (set: bool-type _czyTlumaczyc to false)
        (set: _doWypisaniaSzambolanskie to $slowa's _nrSlowa's 2nd)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's _nrSlowa)
        (if: _doWypisaniaTlumaczenie is an empty)[
            (out: )[_doWypisaniaSzambolanskie]
        ]
        (else: )[
            (out: )[{=
                |slowo>[(cond: _czyTlumaczyc, _doWypisaniaTlumaczenie, _doWypisaniaSzambolanskie)]
                (click-rerun:?slowo)[(set: _czyTlumaczyc to not it)(rerun:?slowo)]
            ]
        ]
    ]))
    (set: $wyczyscTlumaczenia to (macro: [
        (set: $tlumaczeniaGracza to (altered: _entry via "", ...$slowa))
        (out: )[]
    ]))
    (set: $wypiszRubyNr to (macro: num-type _nrSlowa, [
        (set: _doWypisaniaSzambolanskie to $slowa's _nrSlowa's 2nd)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's _nrSlowa)
        (out: )[<ruby>
            _doWypisaniaSzambolanskie
            <rp>(</rp><rt>_doWypisaniaTlumaczenie</rt><rp>)</rp>
        </ruby>]
    ]))
    (set: $wypiszRuby to (macro: str-type _slowo, [
        (set: _doWypisaniaSzambolanskie to $slowa's (_slowo of $slownik)'s 2nd)
        (set: _doWypisaniaTlumaczenie to $tlumaczeniaGracza's $tlumaczeniaGracza's (_slowo of $slownik))
        (out: )[{=
          <ruby>
            _doWypisaniaSzambolanskie
              <rp>(</rp><rt>_doWypisaniaTlumaczenie</rt><rp>)</rp>
          </ruby>]
    ]))
 
  <!-- Sprawdzenie, czy nie ma powtórzeń w słowach po szambolańsku. -->
    (set: _slownikSprawdzenie to (macro: [
        (set: _ileJestRoznychSzambolanskich to (unique: ...(altered: _slowo via _slowo's 2nd, ...$slowa))'s length)
        (set: _ileJestRoznychSlow to $slowa's length)
        (if: _ileJestRoznychSzambolanskich < _ileJestRoznychSlow)[(error: "Więcej niż jedno słowo tłumaczy się na to samo po szambolańsku!")]
        (out: )[]
    ]))
    (_slownikSprawdzenie: )

  <!-- For Settings Autoload -->
    (set: $chosenTheme to "Bright Theme")
    (set: $chosenFront to "Sans-Serif")
    (set: $fontSize to 1.5)
    (set: $setNamingSaves to "Autoname")
  <!-- For the Saves Name -->
    (set: $chapter to "Chapter 1")
    (set: $savesName to $chapter + " - " + $namePC)

  <!-- Rzeczy zależne od motywu -->
    (set: $jesliCiemnyMotyw to (macro: any-type _jesliCiemny, any-type _jesliJasny, [(out: )[{=
      <div class="theme-limited" data-theme="dark">
        _jesliCiemny
      </div>
      <div class="theme-limited" data-theme="light sepia">
        _jesliJasny
      </div>
    ]]))
}


:: StoryScript [script]
// TABLE OF CONTENT
  // I  - SETTINGS
  // II - IMPORT/EXPORT CUSTOM CODE

//---SETTINGS---
  // Theme
  window.settingThemeChange = function(mode) {
    $('body').removeClass('dark-theme sepia-theme light-theme');
    switch (mode) {
      case 2:
        $('body').addClass("sepia-theme");
        break;
      case 1:
        $('body').addClass("dark-theme");
        break;
      default:
        $('body').addClass("light-theme");
        break;
    }
  };
    // Font Family
  window.settingFontFamily = function(mode) {
    $('body').removeClass('serif sansserif monospace');
    switch (mode) {
      case 2:
        $('body').addClass("serif");
        break;
      case 1:
        $('body').addClass("sansserif");
        break;
      default:
        $('body').addClass("monospace");
        break;
    }
  };
    // Font Size
  window.settingFontSize = function(mode) {
    $('tw-story').css( "fontSize", mode + "em" );
  };
  
  //---IMPORT/EXPORT CUSTOM CODE---
    // Harlowe Save to File Custom Macro from Kajot-Dev
  let saveInput;
  
  const { dialog } = require("utils/renderutils");
  const privateSave = {
    //---CONFIGURABLES---
    cheatPassage: false, //string or false boolean
    binKey: 3,
    maxFileSize: 512, //KB
    extension: "sav", //lowercase and without '.'
    //---END OF CONFIGURABLES---
    openDialog: (message, func) => {
      func = typeof func == "function" ? func : () => {};
      if (typeof message == "string") {
        return $("tw-story").append(dialog({
          message,
          buttons: [
            {
              name: "OK",
              callback() {
                func();
              }
            }
          ]
        }));
      } else return null;
    },
    get: saveslot => {
      var archive = [];
      for (let key of Object.keys(localStorage)) {
        if (privateSave.verify(key, true, false, true) === true) {
          if (key.slice(49).trim() === saveslot) archive.push(key, localStorage.getItem(key));
        }
      }
      if (archive.length >= 2) {
        var output = archive.join('\n');
        return output;
      } else {
        return null;
      }
    },
    getDirect: slot => {
      let dataObj = State.serialise();
      let data = null;
      if (dataObj.hasOwnProperty("pastAndPresent")) data = dataObj.pastAndPresent;
      if (typeof data === "string") return "(Saved Game " + privateSave.storyUID + ") " + slot + "\n" + data;
      return null;
    },
    download: (input, fileType, fileName) => {
      if (!input || !fileType || !fileName) return null;
      var fObject = new Blob([input], {
        type: fileType
      });
      var dClick = document.createElement('a');
      dClick.setAttribute('download', fileName);
      dClick.setAttribute('id', 'savedownload');
      dClick.setAttribute('href', URL.createObjectURL(fObject));
      dClick.dataset.downloadurl = [fileType, dClick.download, dClick.href].join(':');
      dClick.style.display = 'none';
      dClick.click();
      setTimeout(function () {
        URL.revokeObjectURL(dClick.href);
      }, 1500);
    },
    encode: (input) => {
      let keys = privateSave.storyUID.split("-");
      input = privateSave.vigenere(input, keys[4]);
      let checkSum = privateSave.checkSum(input, keys[0]);
      input = privateSave.insertCheckSum(input, checkSum, keys[1] + keys[2]);
      input = privateSave.encodeBin(input, privateSave.binKey);
      return input;
    },
    decode: (input) => {
      let keys = privateSave.storyUID.split("-");
      input = privateSave.encodeBin(input, privateSave.binKey);
      let [text, checksum] = privateSave.pullCheckSum(input, keys[0].length, keys[1] + keys[2]);
      input = text;
      let tempVigenere = privateSave.vigenere(input, keys[4], true);
      let check = privateSave.verify(tempVigenere, false, true, false);
      if (check === true) {
        if (checksum === privateSave.checkSum(input, keys[0])) {
          input = tempVigenere;
          return input;
        } else return [null, "cheater"];
      } else return [null, check];
    },
    checkSum: (input, key) => {
      var kody = key.split("").map(x => x.charCodeAt(0));
      while (input.length % key.length != 0) input += ".";
      for (let i = 0; i < input.length / key.length; i++) {
        for (let j = 0; j < key.length; j++) {
          kody[j] = (kody[j] + input.charCodeAt(i * key.length + j)) % 128;
        }
      }
      var out = "";
      for (let i = 0; i < key.length; i++) {
        out += String.fromCharCode(65 + (kody[i] % 26));
      }
      return out;
    },
    insertCheckSum: (input, checksum, key) => {
      while (key.length < checksum.length) key += key;
      key = key.slice(0, checksum.length);
      var kody = key.split("").map(x => x.charCodeAt(0));
      for (let i = 0; i < checksum.length; i++) {
        if (kody[i] < input.length) {
          input = input.slice(0, kody[i]) + checksum[i] + input.slice(kody[i]);
        } else {
          input += checksum[i];
        }
      }
      return input;
    },
    pullCheckSum: (input, checksumLength, key) => {
      while (key.length < checksumLength) key += key;
      key = key.slice(0, checksumLength);
      var kody = key.split("").map(x => x.charCodeAt(0)).reverse();
      var out = "";
      for (let i = 0; i < checksumLength; i++) {
        if (kody[i] < input.length) {
          out += input[kody[i]];
          input = input.slice(0, kody[i]) + input.slice(kody[i] + 1);
        } else {
          out += input[input.length - 1];
          input = input.slice(0, -1);
        }
      }
      out = out.split("").reverse().join("");
      return [input, out];
    },
    vigenere: (input, key, decode) => {
      key = key.length <= input.length ? key : key.slice(0, input.length);
      let pop = 0;
      var out = "";
      for (let i = 0; i < input.length; i++) {
        if (privateSave.vigenereAlphabet.includes(input[i])) {
          let x = privateSave.vigenereAlphabet.indexOf(input[i]);
          let y = privateSave.vigenereAlphabet.indexOf(key[(i - pop) % key.length]);
          if (!decode) {
            x = (x + y) % privateSave.vigenereAlphabet.length;
          } else {
            x -= y;
            if (x < 0) x += privateSave.vigenereAlphabet.length;
          }
          out += privateSave.vigenereAlphabet[x];
        } else {
          out += input[i];
          pop++;
        }
      }
      return out;
    },
    encodeBin: (input, key) => {
      if (typeof key !== 'number') return input;
      key = key.toString();
      var output = '';
      input = input.toString();
      for (let i = 0; i < input.length; i++) {
        let currentLetter = input.charCodeAt(i);
        let encodedLetter = currentLetter ^ key;
        output += String.fromCharCode(encodedLetter);
      }
      return output;
    },
    verify: (text, filBool, commands, verSave) => {
      text = text.includes("\n") ? text.split("\n")[0] : text;
      let StoryId = text.includes('Filename') ? text.slice(21, 57).trim() : text.slice(12, 48).trim();
      filBool = filBool ? !text.includes('Filename') : true;
      verSave = verSave ? text.slice(1, 11).trim() !== "Saved Game" : false;
      if ((text[0] !== "(" || text[6] !== " " || text[11] !== " ") || verSave) {
        if (commands) privateSave.openDialog("This is not a Twine save... is it?");
        return "corrupted_save_name";
      }
      if (StoryId !== privateSave.storyUID) {
        if (commands) privateSave.openDialog("I can't open this save, it's from another Twine game!");
        return "wrong_id";
      }
      if (!filBool) return "wrong_save_key";
      return true;
    },
    process: (fileInput, targetslot, slots, section) => {
      return new Promise((resolve, reject) => {
        slots = Array.isArray(slots) ? slots : [slots];
        var file = fileInput.files[fileInput.files.length - 1];
        if (file.name.slice(file.name.lastIndexOf(".") + 1).toLowerCase() !== privateSave.extension) {
          privateSave.openDialog("Wrong extension, correct one is: ." + privateSave.extension);
          reject("wrong_extension");
          return;
        }
        if (!file || (file.size / 1024) > privateSave.maxFileSize) {
          privateSave.openDialog("File too large (or your browser couldn't provide it)");
          reject("none/too_large");
          return;
        }
        var fileRead = new FileReader();
        fileRead.readAsText(file);
        fileRead.onload = ready => {
          let input = ready.target.result;
          if (input.length <= 50) {
            privateSave.openDialog("Empty/too short file!");
            reject("empty/too_short");
            return;
          }
          input = privateSave.decode(input);
          if (Array.isArray(input)) {
            reject(input[1]);
            return;
          }
          if (input.slice(1, 11) !== "Saved Game") {
            privateSave.openDialog("I can't load this save - is this even a save file?");
            reject("no_phrase");
            return;
          }
          var saveArray = input.split('\n');
          if (saveArray.length < 2) {
            privateSave.openDialog("I can't load this save - can't unpack it!");
            reject("no_line_break");
            return;
          }
          let key = saveArray[0];
          var saveName = key.slice('49').trim();
          if (slots.includes(saveName)) {
            const possibleErr = State.deserialise(section, saveArray[1]);
            if (!(possibleErr instanceof Error)) { //if this returns true, we are absolutely sure, that save is gonna work
              localStorage.setItem("(Saved Game " + privateSave.storyUID + ") " + targetslot, saveArray[1]);
              resolve(true);
            } else {
              console.error(possibleErr);
              privateSave.openDialog("Save corrupted - Twine refused loading it!");
              reject("corrupted_save_data");
            }
          } else {
            privateSave.openDialog("I'm not allowed to load this save!");
            reject("wrong_slot");
          }
        };
        fileRead.onerror = () => {
          privateSave.openDialog("Error reading the file!");
          reject("file_error");
        };
      });
    },
    file: (name, slot) => {
      var saveOutput = privateSave.get(slot);
      if (saveOutput) {
        saveOutput = privateSave.encode(saveOutput);
        privateSave.download(saveOutput, "text/plain", name + "." + privateSave.extension);
      } else {
        privateSave.openDialog("I can't download save which doesn't exists!");
        console.error(...privateSave.appPrefix, "I can't download save which doesn't exists!");
      }
    },
    fileDirect: (name, slot) => {
      let saveData = privateSave.getDirect(slot);
      if (saveData === null) {
        privateSave.openDialog("I couldn't download save - probably Twine's error!");
        return null;
      }
      saveData = privateSave.encode(saveData);
      privateSave.download(saveData, "text/plain", name + "." + privateSave.extension);
    },
    read: (slot, slots, section) => {
      var fileSave = saveInput;
      if (!fileSave) {
        fileSave = document.createElement('input');
        fileSave.setAttribute('type', 'file');
        fileSave.setAttribute('id', 'saveupload');
        fileSave.style.display = 'none';
        fileSave.setAttribute('accept', "." + privateSave.extension);
        fileSave.setAttribute('size', '1');
        fileSave.addEventListener("change", () => {
          privateSave.process(fileSave, slot, slots, section).then(() => {
            fileSave.remove();
            saveInput = undefined;
            Engine.showPassage(State.passage);
            console.log(...privateSave.appPrefix, "Reading from file succesfull");
          }).catch(reason => {
            fileSave.remove();
            saveInput = undefined;
            console.error(...privateSave.appPrefix, "Error reading from file:", reason);
            if (reason == "cheater") {
              if (privateSave.cheatPassage) Engine.goToPassage(privateSave.cheatPassage);
              else privateSave.openDialog("Oszust!");
            }
          });
        }, {
          once: true
        });
        saveInput = fileSave;
      }
      fileSave.click();
    },
    vigenereAlphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890",
    storyUID: document.querySelector('tw-storydata').getAttribute('ifid'),
    appPrefix: ["%cSAVE TO FILE:", "font-weight: bold"]
  };
  
  Object.freeze(privateSave);
  console.info(privateSave.appPrefix[0] + "%c Save to file script is ready!", privateSave.appPrefix[1], "color: green;");
  const Macros = require("macros");
  const TwineError = require("internaltypes/twineerror");
  const TwineNotifier = require("internaltypes/twinenotifier");
  Macros.add("readfromfile", "Instant", function (section, ...args) {
    let t = "";
    if (args.length > 0) {
      let accepted = [];
      if (args.length > 1) accepted = args.slice(1, args.length);
      else accepted = [args[0]];
      privateSave.read(args[0], accepted, section);
    }
    if (Utils.options.debug) t += "(readfromfile:"+args.toString()+ ")";
    return {
      TwineScript_TypeID: "instant",
      TwineScript_TypeName: "a (readfromfile:) operation",
      TwineScript_ObjectName: "a (readfromfile:) operation",
      TwineScript_Unstorable: true,
      TwineScript_Print: function () {
        return t && TwineNotifier.create(t).render()[0].outerHTML;
      }
    }
  }, [String, Macros.TypeSignature.zeroOrMore(String)]);
  Macros.add("savetofile", "Instant", function (_, n, s) {
    let t = "";
    n = n.trim();
    if (n === "" || s === "") return TwineError.create("macrocall", "This macro does not accept empty strings!");
    privateSave.file(n, s);
    if (Utils.options.debug) t += "(savetofile:"+n+", "+s+")";
    return {
      TwineScript_TypeID: "instant",
      TwineScript_TypeName: "a (savetofile:) operation",
      TwineScript_ObjectName: "a (savetofile:) operation",
      TwineScript_Unstorable: true,
      TwineScript_Print: function () {
        return t && TwineNotifier.create(t).render()[0].outerHTML;
      }
    }
  }, [String, String]);
  Macros.add("savetofiledirect", "Instant", function (_, n, s) {
    let t = "";
    n = n.trim();
    if (n === "" || s === "") return TwineError.create("macrocall", "This macro does not accept empty strings!");
    privateSave.fileDirect(n, s);
    if (Utils.options.debug) t += "(savetofiledirect:"+n+", "+s+")";
    return {
      TwineScript_TypeID: "instant",
      TwineScript_TypeName: "a (savetofiledirect:) operation",
      TwineScript_ObjectName: "a (savetofiledirect:) operation",
      TwineScript_Unstorable: true,
      TwineScript_Print: function () {
        return t && TwineNotifier.create(t).render()[0].outerHTML;
      }
    }
  }, [String, String]);

:: StoryStylesheet [stylesheet]
/*
      // TABLE OF CONTENT
  // I   - BASE FIXES
  // II  - HEADER/FOOTER
  // III - POPUPS
  // IV  - SETTINGS RELATED CODE
  // V   - MEDIA RESIZE
*/

  /***** BASE FIXES *****/
/*
  These fixes are mainly because I wanted the guide to look a certain way. 
  You can disregard them in your own project.

  Includes:
  - fixed header/footer (resize of passage)
  - moved background to body (avoid blank space during scrolling)
  - changed the cursor for relevant interactive elements
*/
body {
  background: black;
  color: white;
}
tw-story {
  background: unset;
  color: unset;
}
tw-sidebar {
  z-index: 100;
}

tw-dialog {
  border-radius: 8px;
}

select, input[type="checkbox"], label {
  cursor: pointer;
}

  /***** HEADER/FOOTER *****/
/*
  While colours are set in the settings, I'm just leaving these as a backup/testing purposes.
  The background is needed, or you'd see the passage text under it. (correct color in the SETTING section)
*/
tw-header, tw-footer {
  display:block;
  position: fixed;
  background: black;
  left: 0;
  right: 0;
  z-index: 100;
}
tw-header {
  top: 0;
  border-bottom: 1px white dotted;
  font-size: 2em;
  padding: 10px;
}
tw-footer {
  bottom:0;
  border-top: 1px white dotted;
  font-size: 1.5em;
  padding: 3px;
}

  /***** POPUPS *****/
/*
  This is the code for the custom popups.
  Again the black background is for backup loading
*/
.popup {
  width: max-content;
  height: max-content;

  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  margin: auto;

  visibility: hidden;
  display:none;

  background: black;
  outline: 1px solid darkred;
}
/* 
  With every custom popup you create, you need to add the new ID below, or it won't open. 
*/
#popup-dictionary.open, #popup-save.open, #popup-settings.open, #popup-credits.open, #popup-save1.open {
  visibility: visible;
  z-index: 110;
  display: block;
}
#popup-close {
  position: absolute;
  top: 11px;
  right: 10px;
  font-size: 50px;
  height: 58px;
  width: 50px;
}
#popup-close tw-hook {
  margin-left: 15px;
}
#popup-close tw-link {
  color: darkred;
}
#popup-close tw-link:hover {
  color: white;
  text-shadow: 0px 0px 20px red;
}

#popup-title {
  text-align: center;
  margin: 0.2em 0 0.3em;
  line-height: 0.8em;
}
.popup hr {
  border: none;
  border-bottom: 2px dotted;
}
#popup-body {
  overflow: auto;
  padding: 1% 2% 3%;
  width: 100%;
  height: max-content;
  margin: auto;
  max-height: 75vh;
  max-width: 600px;
}
  /* Popup Specific */
.fake-button {
  font-weight: bold;
  color: grey;
  cursor: not-allowed;
}
imp-exp#saves {
  display: flex;
  text-align: center;
  align-items: center;
}
imp-exp#saves > * {
  padding: 0 5px;
}

table#settings td {
  min-width: 200px;
  text-align: right;
}

table#settings th {
  text-align: right;
  width: 150px;
}

#dictionary-table {
  border-collapse: collapse;
}

#dictionary-table th, #dictionary-table td {
  padding-inline: 0.5em
}

#dictionary-table thead th {
  border-bottom: 3px double black;
}

#dictionary-table tbody tr + tr td {
  border-top: 1px solid black;
}

#dictionary-table .translation-editor > :first-child {
  display: inline-block !important;
  width: unset !important;
  margin-right: 0.25em;
}

  /***** SETTINGS *****/
/*
  Below is the code for any settings requiring a class.
*/
  /* Font Family */

.serif tw-story {
  font-family: serif;
}
.sansserif tw-story {
  font-family: sans-serif;
}
.monospace tw-story {
  font-family: monospace;
}

  /* Themes */

body.light-theme {
  background-color: white;
  color: black;
}
body.dark-theme {
  background-color: #242424;
  color: #e8e7e7;
}
body.sepia-theme {
  background-color: #F7F4F1;
  color: #7b3012;
}

.light-theme tw-header, .light-theme tw-footer {
  background: white;
  border-color: black;
}
.dark-theme tw-header, .dark-theme tw-footer {
  background: #242424;
  border-color: white;
}
.sepia-theme tw-header, .sepia-theme tw-footer {
  background: #F7F4F1;
  border-color: black;
}

.light-theme tw-dialog {
  background: white;
  color: black;
  border-color: black;
}
.dark-theme tw-dialog {
  background: #242424;
  color: #e8e7e7;
  border-color: white;
}
.sepia-theme tw-dialog {
  background: #F7F4F1;
  color: #7b3012;
  border-color: black;
}

.light-theme .popup {
  background: white;
}
.dark-theme .popup {
  background: #242424;
}
.sepia-theme .popup {
  background: #F7F4F1;
}

.light-theme #popup-close tw-link:hover {
  color: red;
}
.sepia-theme #popup-close tw-link:hover {
  color: red;
}

.light-theme tw-story select {
  background: white;
}
.dark-theme tw-story select {
  background: #222;
}
.sepia-theme tw-story select {
  background: white;
}

.light-theme tw-link {
  color: #3559c4;
}
.dark-theme tw-link {
  color: #6487ee;
}
.sepia-theme tw-link {
  color: #3559c4;
}

.light-theme tw-link:hover {
  color: darkred;
}
.dark-theme tw-link:hover {
  color: #43d0ff;
}
.sepia-theme tw-link:hover {
  color: #048b00;
}

.theme-limited {
   display: contents;
}

.light-theme .theme-limited:not([data-theme~="light"]) {
  display: none;
}
.dark-theme .theme-limited:not([data-theme~="dark"]) {
  display: none;
}
.sepia-theme .theme-limited:not([data-theme~="sepia"]) {
  display: none;
}

  /***** MOBILE *****/
/*
  Because I added a header and footer, and it's messing with stuff.
  And this is the UGLIEST way of doing mobile accessibility.
    What really should be done is:
      - reduce the font of the header/footer as you decrease the width
      - *then* mess around with the padding of tw-story
    (this would really not be an issue with tw-sidebar wasn't nested inside tw-story, but that's a rant for another template)
*/
@media screen and (max-width: 1000px) {
  tw-story {
    padding: 9% 20% 5%;
  }
}
@media screen and (max-width: 600px) {
  tw-story {
    padding: 16% 5%;
  }
  .popup {
    max-width: 97%;
  }
}
@media screen and (max-width: 375px) {
  tw-story {
    padding: 35% 5%;
  }
}

  /***** OTHER *****/
/*
  Below is the code for any settings requiring a class.
*/
/*This code is so I could display the examples*/
pre {
  width: fit-content;
  padding: 0 1em 1em;
  border-radius: 6px;
}
.light-theme pre, .sepia-theme pre {
  background: lavender;
}
.dark-theme pre {
  background: #333357;
}